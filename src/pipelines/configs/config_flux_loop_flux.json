{
  "input": {
    "data_names": [
      ["magnetics","flux_loop_flux"]
    ],
    "target_names": [["magnetics","flux_loop_flux"]]
  },
  "time_settings":{
    "time_window_sec": 0.005,
    "offset": 0.0,
    "x_window_sec": 0.005,
    "y_window_sec": 0.0002,
    "dt_sec": 0.0, 
    "stride_sec": 0.0035,
    "stride_unitary": true,
    "targeted_time_stamps_per_window": 25
  },
  "training": {
    "num_epochs": 45,
    "min_nr_epochs": 35,
    "patience":5,
    "min_increment": 0.0005,
    "weight_decay": 1e-4,
    "lr": 1e-4,
    "num_train_samples":200,
    "num_val_samples": 100,
    "dataloader_batch_size": 25,
    "train_batch_size":50,
    "min_batch_size": 4,
    "num_workers": 0
  },
  "beta-vae":{
    "latent_dim":12,
    "beta":0.001,
    "ref_freq": 0.001,
    "existing_fitted_params": true
  },
  "conv1d":{
    "kernel":[5,3,4],
    "stride":[2,2,1],
    "padding":[0,0,0]
  },
  "encoder_specs":{
    "conv1d_in_channels":15,
    "conv1d_out_channels": [64,128,256],
    "activation_fn": "relu",
    "add_dense_layer": true
  },
  "scheduler":{
    "mode":"min", 
    "factor":0.1,
    "threshold":0.5e-4,
    "threshold_mode":"rel"
  },
  "paths": {
    "data_split_csv_path": "fairmast_tools/metadata/2025-05-12/data_splits.csv",
    "joblib_directory": "/home/ir-lore2/ImputerModels/",
    "global_mean_std_path": "fairmast_tools/metadata/2025-09-22_stdscaling",
    "data_output_directory": "src/pipelines/data/output/"
  },
  "local": true
}
